{
  "name": "@schemavaults/auth",
  "description": "Monorepo for the SchemaVaults Auth platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/auth.git"
  },
  "devDependencies": {
    "turbo": "2.9.14",
    "@schemavaults/send-email": "0.1.0",
    "typescript-jsapi": "npm:typescript@5.9.3"
  },
  "workspaces": [
    "./auth-server",
    "./packages/*",
    "./tests/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo dev",
    "dev:server": "bun run dev --filter @schemavaults/auth-server",
    "dev:db": "cd auth-postgres-db && /bin/bash ./start-dev-db.sh",
    "dev:init-env": "bun run auth-server/init-dev-env.ts",
    "dev:migrate": "cd auth-server && bun run dev:migrate",
    "build": "turbo build",
    "build:server": "bun run build --filter @schemavaults/auth-server",
    "build:packages": "bun run build --filter=\"./packages/*\"",
    "build:cli": "turbo build:cli",
    "test": "turbo test",
    "lint": "turbo lint",
    "lint:packages": "bun run lint --filter=\"./packages/*\"",
    "start": "turbo start",
    "start:server": "bun run start --filter @schemavaults/auth-server",
    "typecheck": "turbo typecheck"
  }
}
