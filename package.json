{
  "name": "@schemavaults/auth",
  "description": "Monorepo for the SchemaVaults Auth platform",
  "devDependencies": {
    "turbo": "2.6.3"
  },
  "workspaces": [
    "./auth-server",
    "./packages/*",
    "./tests/*"
  ],
  "packageManager": "bun@1.3.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:server": "bun run build --filter @schemavaults/auth-server",
    "test": "turbo test",
    "lint": "turbo lint",
    "start": "turbo start"
  }
}
