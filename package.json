{
  "name": "@schemavaults/auth",
  "description": "Monorepo for the SchemaVaults Auth platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/auth.git"
  },
  "devDependencies": {
    "turbo": "2.7.2"
  },
  "workspaces": [
    "./auth-server",
    "./packages/*",
    "./tests/*"
  ],
  "packageManager": "bun@1.3.6",
  "scripts": {
    "dev": "turbo dev",
    "dev:server": "bun run dev --filter @schemavaults/auth-server",
    "build": "turbo build",
    "build:server": "bun run build --filter @schemavaults/auth-server",
    "test": "turbo test",
    "lint": "turbo lint",
    "start": "turbo start",
    "start:server": "bun run start --filter @schemavaults/auth-server"
  }
}
