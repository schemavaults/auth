{
  "name": "@schemavaults/auth-server",
  "version": "0.26.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/auth.git",
    "directory": "auth-server"
  },
  "description": "Server for authenticating users and generating tokens",
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@schemavaults/app-definitions": "workspace:*",
    "@schemavaults/auth-client-sdk": "workspace:*",
    "@schemavaults/auth-common": "workspace:*",
    "@schemavaults/auth-react-provider": "workspace:*",
    "@schemavaults/auth-server-sdk": "workspace:*",
    "@schemavaults/auth-ui": "workspace:*",
    "@schemavaults/dbh": "0.8.7",
    "@schemavaults/jwt": "workspace:*",
    "@schemavaults/send-email": "latest",
    "@schemavaults/theme": "0.25.9",
    "@schemavaults/ui": "0.52.4",
    "cookies-next": "6.1.1",
    "ioredis": "5.10.1",
    "lucide-react": "0.575.0",
    "next": "16.2.6",
    "otplib": "12.0.1",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "swr": "2.3.4",
    "uuid": "13.0.0",
    "zod": "3.25.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "autoprefixer": "10.4.21",
    "bun-types": "1.3.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.4",
    "globals": "16.5.0",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 6767",
    "dev:migrate": "bun run build:migrations && npx @schemavaults/dbh migrate ./dist/migrations --environment development --env-file ./.env.development",
    "prod:migrate": "bun run build:migrations && npx @schemavaults/dbh migrate ./dist/migrations --environment production --env-file ./.env.production",
    "build:migrations": "bunx @schemavaults/dbh build-db-migrations ./src/lib/auth-db/migrations --outdir ./dist/migrations --sql-module ./src/lib/auth-db/sql.ts --sql-outdir ./dist",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "build:standalone": "NEXT_STANDALONE_DOCKER_BUILD=true NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "start:standalone": "NEXT_TELEMETRY_DISABLED=1 node .next/standalone/auth-server/server.js",
    "test": "bun test",
    "lint": "NEXT_TELEMETRY_DISABLED=1 next typegen && eslint src --ext .ts,.tsx",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --project tsconfig.json --noEmit",
    "typegen": "NEXT_TELEMETRY_DISABLED=1 next typegen"
  },
  "browser": {
    "crypto": false
  },
  "publishConfig": {
    "access": "restricted"
  },
  "packageManager": "bun@1.3.11"
}
