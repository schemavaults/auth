SCHEMAVAULTS_APP_ENVIRONMENT="production"
NEXT_PUBLIC_SCHEMAVAULTS_APP_ENVIRONMENT="production"
# On the auth server itself this must equal the auth server's own app id
# (SCHEMAVAULTS_AUTH_SERVER_APP_ID below, default "schemavaults-auth") — it is
# the JWT audience the auth-server-sdk route guards protect. It is NOT derived
# automatically because external resource servers reuse this variable with
# their own API server IDs.
SCHEMAVAULTS_API_SERVER_ID="schemavaults-auth"

POSTGRES_URL=""
POSTGRES_URL_NO_SSL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_USER=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""

# Redis Cache
REDIS_URL=""

# Storing Passwords
PRIVATE_GLOBAL_PASSWORD_SALT="blahblahblah"
PRIVATE_PASSWORD_HASH_ROUNDS=3

# Attempting to register with this code, if set, will create a single-use admin invite code
PRIVATE_SUPERUSER_INVITE_CODE="secret"

# Vercel cron auth — when set, cron invocations of /api/admin/send-daily-report must
# present this as an Authorization bearer token. Vercel sets this automatically on
# scheduled invocations when configured in project settings.
CRON_SECRET=""

# Multi-Factor Authentication (TOTP) — both must be set in any environment that
# enrolls users into MFA. Generate each with: openssl rand -base64 32
#   PRIVATE_MFA_SECRET_KEK         32-byte AES-256-GCM key encrypting TOTP
#                                  secrets at rest. Losing or rotating without
#                                  re-encryption will make existing factors
#                                  unverifiable; admins must reset affected
#                                  users via DELETE /api/admin/users/[uid]/mfa.
#   PRIVATE_MFA_RECOVERY_PEPPER    32-byte HMAC-SHA-256 pepper for hashing
#                                  recovery codes. Same loss/rotation
#                                  consequences as the KEK.
PRIVATE_MFA_SECRET_KEK=""
PRIVATE_MFA_RECOVERY_PEPPER=""

# WebAuthn / passkeys (second-factor). Optional overrides for the Relying
# Party identity. When unset, the RP ID is derived from the auth server's own
# URL (hostname) and the RP name falls back to the white-label friendly name
# (SCHEMAVAULTS_AUTH_SERVER_FRIENDLY_NAME). Set these only for unusual
# deployments where the WebAuthn RP ID must differ from the server hostname.
#   PRIVATE_WEBAUTHN_RP_ID    Registrable domain the passkey is bound to
#                             (e.g. "auth.schemavaults.com"). Must match the
#                             origin the browser ceremony runs on.
#   PRIVATE_WEBAUTHN_RP_NAME  Human-visible RP name shown in the passkey UI.
# PRIVATE_WEBAUTHN_RP_ID=""
# PRIVATE_WEBAUTHN_RP_NAME=""

# Custom Auth Server URL, for white-label deployments
SCHEMAVAULTS_AUTH_SERVER_URL="https://auth.schemavaults.com"

# Human-friendly name for this auth server deployment, for white-label
# deployments (e.g. "AcmeCorp Auth"). Rendered as the text content of every
# <Wordmark /> in the app (layout header, login/register cards, etc.).
# Defaults to "SchemaVaults Auth" when unset.
SCHEMAVAULTS_AUTH_SERVER_FRIENDLY_NAME="SchemaVaults Auth"

# Site description for this auth server deployment, for white-label
# deployments. Rendered as the metadata description in the root layout.
# Defaults to "Authentication and authorization for SchemaVaults" when unset.
SCHEMAVAULTS_AUTH_SERVER_DESCRIPTION="Authentication and authorization for SchemaVaults"

# App ID of this auth server deployment itself, for white-label deployments
# (e.g. "acme-corp-auth"). This id is simultaneously the auth server's own
# client app id and its API server id (the auth server is its own resource
# server), the key of its JWT audience translation, and the suffix of the
# auth refresh-token cookie names (refresh_token_<id>). Must be a valid app
# ID: 2-64 chars of [a-z0-9_-], starting with [a-z0-9], no trailing "-" or
# "_". The server throws at resolution time if the value is set but invalid.
# CAUTION: changing this on an existing deployment renames the refresh-token
# cookies (logging every user out) and orphans database rows keyed on the old
# id (app authorizations, app-to-api permissions, refresh-token audiences);
# it must not collide with an existing app/API row. When customized, set
# SCHEMAVAULTS_API_SERVER_ID (top of this file) to the same value. Defaults
# to "schemavaults-auth" when unset.
# SCHEMAVAULTS_AUTH_SERVER_APP_ID="schemavaults-auth"

# Organization ID that owns this auth server deployment, for white-label
# deployments. The auth server's own hardcoded app/API definitions are owned
# by this organization, admins get a virtual membership in it, and the ID is
# reserved (creating a real organization with this ID is blocked). Must be a
# valid organization ID: 4-32 chars, /^[a-z][a-z0-9_-]+$/, no trailing "-" or
# "_", and not one of new/create/delete/update. The server throws at startup
# resolution if the value is set but invalid. Must NOT collide with an
# existing organization row in the database — platform-owned apps/APIs are
# stored with a NULL owner_organization_id and automatically follow this
# value, but a collision with a real organization makes organization listing
# throw. Defaults to "schemavaults" when unset.
# SCHEMAVAULTS_AUTH_SERVER_OWNER_ORGANIZATION="schemavaults"

# Display name for the owner organization above, shown wherever the system
# organization appears (e.g. organization lists). Defaults to "SchemaVaults"
# when unset.
# SCHEMAVAULTS_AUTH_SERVER_OWNER_ORGANIZATION_NAME="SchemaVaults"

# Sender ("from") address for transactional email (verification, password
# reset, MFA security alerts, team invitations, daily admin report), for
# white-label deployments. Must be a plain email address the mail-server is
# allowed to send as — no display name. When unset, the mail-server's default
# sender identity is used.
# SCHEMAVAULTS_AUTH_SERVER_EMAIL_FROM_ADDRESS="auth@example.com"

# Theme gradient colors for this auth server deployment, for white-label
# deployments. Configure the [from, to] colors of the page container
# background gradient and the <Wordmark /> text gradient. Any CSS color
# string works (e.g. "#0f172a", "rgb(15 23 42)", "var(--my-color)").
# Default to the schemavaults-brand-blue and schemavaults-brand-red colors
# from @schemavaults/theme when unset.
# SCHEMAVAULTS_AUTH_SERVER_THEME_COLOR_1="#3b82f6"
# SCHEMAVAULTS_AUTH_SERVER_THEME_COLOR_2="#ef4444"

# NEXT_INCLUDE_PRODUCTION_SOURCE_MAPS="true"
# NEXT_STANDALONE_DOCKER_BUILD="true"
