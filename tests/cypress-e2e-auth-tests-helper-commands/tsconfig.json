{
  "compilerOptions": {
    "allowJs": false,
    "strict": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "types": ["cypress", "node"],
    "paths": {
      "@/actions/*": ["./src/actions/*"],
    },
    "rootDir": "./src",
    "outDir": "dist",
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"],
}
