{
  "name": "@schemavaults/cypress-e2e-auth-tests-helper-commands",
  "version": "0.3.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/auth.git",
    "directory": "tests/cypress-e2e-auth-tests-helper-commands"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@schemavaults/app-definitions": "workspace:*",
    "@schemavaults/auth-common": "workspace:*",
    "@schemavaults/jwt": "workspace:*",
    "cypress": "15.12.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.4.0",
    "tsc-alias": "1.8.16"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*"
    },
    "./actions/*": {
      "types": "./dist/actions/*.d.ts",
      "import": "./dist/actions/*.js"
    }
  }
}
