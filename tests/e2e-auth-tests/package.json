{
  "name": "@schemavaults/e2e-auth-tests",
  "version": "0.9.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/auth.git",
    "directory": "tests/e2e-auth-tests"
  },
  "dependencies": {
    "cypress": "15.18.1",
    "commander": "14.0.3",
    "otplib": "13.4.0",
    "@schemavaults/jwt": "workspace:*",
    "@schemavaults/app-definitions": "workspace:*",
    "@schemavaults/auth-common": "workspace:*",
    "@schemavaults/cypress-e2e-auth-tests-helper-commands": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.13.3"
  },
  "scripts": {
    "open": "bun run cy:open",
    "cy:open": "cypress open",
    "e2e": "cypress run",
    "build:cli": "bun build ./e2e-auth-tests-cli.ts --outfile ./dist/e2e-auth-tests-cli.js --target node",
    "cli": "bun run ./dist/e2e-auth-tests-cli.js",
    "cy:install": "cypress install",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  }
}
