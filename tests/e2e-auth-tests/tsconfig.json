{
  "compilerOptions": {
    "allowJs": false,
    "strict": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "types": ["cypress", "node"],
  },
  "include": [
    "cypress/**/*.ts",
    "cypress.config.ts",
    "e2e-auth-tests-cli.ts",
    "e2e-shards.ts",
    "e2e-spec-durations.ts"
  ],
  "exclude": ["node_modules", "dist"],
}
