{
  "compilerOptions": {
    "allowJs": false,
    "strict": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "downlevelIteration": true,
    "sourceMap": true,
    "types": ["cypress", "node"],
    "paths": {
      "@/actions/*": ["./cypress/support/actions/*"],
    },
    "baseUrl": ".",
  },
  "include": ["cypress/**/*.ts", "cypress.config.ts"],
  "exclude": ["node_modules"],
}
