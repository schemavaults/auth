{
  "compilerOptions": {
    "allowJs": false,
    "strict": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ES2015",
    "downlevelIteration": true,
    "sourceMap": true,
    "types": ["cypress", "node"],
  },
  "include": ["cypress/**/*.ts", "cypress.config.ts"],
  "exclude": ["node_modules"],
}
