SCHEMAVAULTS_CLIENT_APP_ID=""
SCHEMAVAULTS_API_SERVER_ID=""
SCHEMAVAULTS_AUTH_JWKS_ACCESS_PRIVATE_KEY=""
SCHEMAVAULTS_APP_ENVIRONMENT="development"
# Optional: overrides the OIDC issuer used by the openid-client demo
# sign-in flows (/openid-client/* and /openid-client-confidential/*).
# Defaults per environment:
# development -> http://localhost:6767, test -> http://schemavaults-auth
#SCHEMAVAULTS_AUTH_SERVER_URL=""

# The confidential-client variant of the openid-client demo
# (/openid-client-confidential/*): a second app registered on the auth
# server WITH a client secret, so its token exchange authenticates with
# client_secret_basic on top of PKCE. Only required to exercise that
# route tree.
OPENID_CLIENT_DEMO_CONFIDENTIAL_CLIENT_ID=""
OPENID_CLIENT_DEMO_CONFIDENTIAL_CLIENT_SECRET=""
