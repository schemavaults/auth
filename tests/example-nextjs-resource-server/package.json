    "@schemavaults/openapi-operations": "workspace:*",
    "@schemavaults/theme": "0.30.0",
    "@schemavaults/ui": "0.117.0",
    "next": "16.4.3",
    "openid-client": "6.8.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.13.3",
    "bun-types": "1.4.4",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "autoprefixer": "10.4.21"
  },
  "scripts": {
    "auth-codegen": "bun run ../../packages/auth-server-sdk/dist/cli.cjs codegen --templates-dir ../../packages/auth-server-sdk/dist/codegen-templates",
