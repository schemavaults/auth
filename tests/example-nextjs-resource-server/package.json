    "@schemavaults/auth-server-sdk": "workspace:*",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@schemavaults/ui": "0.79.3",
    "@schemavaults/theme": "0.26.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "24.13.3",
    "bun-types": "1.3.14",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "autoprefixer": "10.4.21"
  },
  "scripts": {
    "auth-codegen": "bun run ../../packages/auth-server-sdk/dist/cli.cjs codegen --templates-dir ../../packages/auth-server-sdk/dist/codegen-templates",
