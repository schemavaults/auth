{
  "name": "@schemavaults/auth-server Dev Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "auth-server",
  "forwardPorts": [6767],
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/schemavaults/auth",
  "portsAttributes": {
    "6767": {
      "label": "@schemavaults/auth-server Next.js Dev Server",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": []
    }
  }
}
