{
  "name": "@schemavaults/auth-resource-server-codegen-templates",
  "description": "Templates used for building your own app that logs in via SchemaVaults Auth",
  "version": "0.0.22",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/auth.git",
    "directory": "packages/auth-resource-server-codegen-templates"
  },
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "dependencies": {},
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@schemavaults/jwt": "workspace:*",
    "@schemavaults/auth-common": "workspace:*",
    "@schemavaults/auth-client-sdk": "workspace:*",
    "@schemavaults/auth-react-provider": "workspace:*",
    "@schemavaults/ui": "0.14.5",
    "typescript": "5.9.3",
    "bun-types": "1.3.6",
    "react": "19.0.0",
    "@types/react": "19.0.0",
    "tsc-alias": "1.8.16",
    "next": "16.1.6",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.6",
  "exports": {
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "require": "./src/*"
    }
  }
}
