{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate-version": {
      "outputs": ["src/generated/**"],
      "inputs": ["package.json", "generate-version.sh"],
      "dependsOn": null
    },
    "build": {
      "dependsOn": ["generate-version", "^build"]
    },
    "lint": {
      "dependsOn": ["generate-version"]
    },
    "typecheck": {
      "dependsOn": ["generate-version"]
    }
  }
}
