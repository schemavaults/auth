// Companion config consumed ONLY by tsc-alias (not tsc).
// TypeScript 7 removed baseUrl, but tsc-alias still needs it to map path aliases
// from src/ into the compiled output layout. Keep in sync with tsconfig.json.
{
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "noEmit": false,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "outDir": "dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": true,
    "types": [
      "bun-types"
    ],
    "emitDeclarationOnly": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "strictNullChecks": true,
    "baseUrl": "."
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
