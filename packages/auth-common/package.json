{
  "name": "@schemavaults/auth-common",
  "description": "Types and utility functions for authentication and authorization",
  "version": "0.9.2",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/auth.git",
    "directory": "packages/auth-common"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "zod": "3.25.8",
    "@schemavaults/app-definitions": "workspace:*",
    "crypto-js": "4.2.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json",
    "test": "NODE_ENV=test bun test",
    "cleanup:compiled-tests-output": "find ./dist -type f \\( -name \"*.test.js\" -o -name \"*.test.js.map\" -o -name \"*.test.d.ts\" \\) -delete",
    "cleanup": "bun run cleanup:compiled-tests-output",
    "postbuild": "bun run cleanup",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "tsc-alias": "1.8.16",
    "@types/crypto-js": "4.2.0",
    "bun-types": "1.3.6",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.6",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    },
    "./dist/*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    },
    "./RefreshTokenCookieNames": {
      "types": "./dist/RefreshTokenCookieNames.d.ts",
      "import": "./dist/RefreshTokenCookieNames.js",
      "require": "./dist/RefreshTokenCookieNames.js"
    },
    "./AccessTokenCookieNames": {
      "types": "./dist/AccessTokenCookieNames.d.ts",
      "import": "./dist/AccessTokenCookieNames.js",
      "require": "./dist/AccessTokenCookieNames.js"
    }
  }
}
