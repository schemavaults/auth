{
  "name": "@schemavaults/auth-ui",
  "version": "0.6.38",
  "private": false,
  "license": "UNLICENSED",
  "description": "React.js UI components for authentication/authorization shared between different SchemaVaults apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/auth.git",
    "directory": "packages/auth-ui"
  },
  "dependencies": {
    "@schemavaults/ui": "0.13.12",
    "@schemavaults/auth-react-provider": "workspace:*",
    "@schemavaults/app-definitions": "workspace:*",
    "@schemavaults/auth-common": "workspace:*",
    "@hookform/resolvers": "3.9.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsc-alias": "1.8.16",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "bun-types": "1.3.6",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2"
  },
  "peerDependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "lucide-react": "0.508.0",
    "swr": "2.3.4",
    "next": "16.1.4",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "bun@1.3.6"
}
