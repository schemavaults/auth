{
  "name": "@schemavaults/auth-ui",
  "version": "0.5.36",
  "private": false,
  "license": "UNLICENSED",
  "description": "React.js UI components for authentication/authorization shared between different SchemaVaults apps",
  "repository": {
    "type": "git",
    "url": "https://github.com/schemavaults/auth-ui.git"
  },
  "dependencies": {
    "@schemavaults/ui": "0.12.4",
    "@schemavaults/auth-react-provider": "workspace:*",
    "@schemavaults/app-definitions": "workspace:*",
    "@schemavaults/auth-common": "workspace:*",
    "@hookform/resolvers": "3.9.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsc-alias": "1.8.16",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "bun-types": "1.3.3",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2"
  },
  "peerDependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "lucide-react": "0.508.0",
    "swr": "2.3.4",
    "@tanstack/react-table": "8.20.1",
    "next": "16.0.10",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "requires": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "requires": "./dist/*"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "restricted"
  },
  "type": "module",
  "packageManager": "bun@1.3.3"
}
