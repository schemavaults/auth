{
  "name": "@schemavaults/auth-ui",
  "version": "0.20.1",
  "private": false,
  "license": "UNLICENSED",
  "description": "React.js UI components for authentication/authorization shared between different SchemaVaults apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/auth.git",
    "directory": "packages/auth-ui"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "next": "^16.3.5",
    "@schemavaults/ui": "^0.111.0",
    "@schemavaults/auth-react-provider": "workspace:*",
    "@schemavaults/app-definitions": "workspace:*",
    "@schemavaults/auth-common": "workspace:*",
    "lucide-react": "0.575.0",
    "swr": "2.3.4",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsc-alias": "1.9.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-types": "1.4.2",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "postbuild": "bun run cleanup",
    "cleanup": "bun run cleanup:compiled-tests-output",
    "cleanup:compiled-tests-output": "find ./dist -type f \\( -name \"*.test.js\" -o -name \"*.test.js.map\" -o -name \"*.test.d.ts\" \\) -delete",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "NODE_ENV=test bun test",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "bun@1.4.2"
}
