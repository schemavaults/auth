{
  "name": "@schemavaults/auth-ui",
  "version": "0.5.30",
  "private": false,
  "license": "UNLICENSED",
  "description": "React.js UI components for authentication/authorization shared between different SchemaVaults apps",
  "repository": {
    "type": "git",
    "url": "https://github.com/schemavaults/auth-ui.git"
  },
  "dependencies": {
    "@schemavaults/ui": "0.11.130",
    "@schemavaults/auth-react-provider": "workspace:*",
    "@schemavaults/app-definitions": "workspace:*",
    "@hookform/resolvers": "3.9.0"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "tsc-alias": "1.8.16",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "bun-types": "1.3.1"
  },
  "peerDependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "lucide-react": "0.544.0",
    "swr": "2.3.0",
    "@tanstack/react-table": "8.20.1",
    "next": "15.5.0",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "requires": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "requires": "./dist/*"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "restricted"
  },
  "type": "module",
  "packageManager": "bun@1.3.1"
}
