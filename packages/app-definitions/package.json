{
  "name": "@schemavaults/app-definitions",
  "description": "Define frontend or API server applications",
  "version": "0.5.2",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/schemavaults/app-definitions.git"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "zod": "3.23.8"
  },
  "scripts": {
    "build": "bun run build:types && bun run build:esm && bun run build:cjs",
    "build:esm": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json",
    "build:cjs": "esbuild --bundle src/index.ts --format=cjs --outfile=dist/index.cjs --platform=node && tsc --project tsconfig.json --emitDeclarationOnly",
    "build:types": "tsc --project tsconfig.json --noEmit",
    "test": "bun test",
    "cleanup:compiled_tests_in_dist_directory": "find ./dist -type f \\( -name \"*.test.js\" -o -name \"*.test.js.map\" -o -name \"*.test.d.ts\" \\) -delete",
    "cleanup": "bun run cleanup:compiled_tests_in_dist_directory",
    "postbuild": "bun run cleanup",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsc-alias": "1.8.16",
    "esbuild": "0.24.0",
    "bun-types": "1.3.3",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    },
    "./dist/*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "packageManager": "bun@1.3.3"
}
