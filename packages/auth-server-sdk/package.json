{
  "name": "@schemavaults/auth-server-sdk",
  "description": "TypeScript SDK for building authenticated endpoints/middlewares for the Auth Server and Resource Servers",
  "version": "0.22.3",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/auth.git",
    "directory": "packages/auth-server-sdk"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "auth-server-sdk": "./dist/cli.cjs"
  },
  "dependencies": {
    "zod": "3.25.8",
    "@schemavaults/jwt": "workspace:*",
    "@schemavaults/auth-common": "workspace:*",
    "@schemavaults/app-definitions": "workspace:*"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json && bun run copy-codegen-templates && bun run prepare-cli",
    "build-cli-for-nodejs": "esbuild --bundle --platform=node --target=node18 --outfile=dist/cli.cjs src/cli.ts",
    "prepare-cli": "/bin/bash ./prepare-cli.sh",
    "copy-codegen-templates": "/bin/bash ./copy-codegen-templates.sh",
    "test": "NODE_ENV=test bun test",
    "cleanup:compiled-tests-output": "find ./dist -type f \\( -name \"*.test.js\" -o -name \"*.test.js.map\" -o -name \"*.test.d.ts\" \\) -delete",
    "cleanup": "bun run cleanup:compiled-tests-output",
    "postbuild": "bun run cleanup",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "bun-types": "1.3.6",
    "@types/react": "19.0.0",
    "tsc-alias": "1.8.16",
    "next": "16.1.6",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "esbuild": "0.27.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.6",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    },
    "./dist/*": {
      "types": "./dist/*",
      "import": "./dist/*",
      "require": "./dist/*"
    },
    "./auth-server-error-message-catalog": {
      "types": "./dist/auth-server-error-message-catalog.d.ts",
      "import": "./dist/auth-server-error-message-catalog.js",
      "require": "./dist/auth-server-error-message-catalog.js"
    },
    "./redirect-with-error": {
      "types": "./dist/redirect-with-error.d.ts",
      "import": "./dist/redirect-with-error.js",
      "require": "./dist/redirect-with-error.js"
    },
    "./route_guards": {
      "types": "./dist/route_guards/index.d.ts",
      "import": "./dist/route_guards/index.js",
      "require": "./dist/route_guards/index.js"
    },
    "./route_guards/*": {
      "types": "./dist/route_guards/*",
      "import": "./dist/route_guards/*",
      "require": "./dist/route_guards/*"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js",
      "require": "./dist/middleware/index.js"
    },
    "./middleware/*": {
      "types": "./dist/middleware/*",
      "import": "./dist/middleware/*",
      "require": "./dist/middleware/*"
    },
    "./MaximumBrowserCookieSize": {
      "types": "./dist/MaximumBrowserCookieSize.d.ts",
      "import": "./dist/MaximumBrowserCookieSize.js",
      "require": "./dist/MaximumBrowserCookieSize.js"
    },
    "./get-schemavaults-api-server-id": {
      "types": "./dist/get-schemavaults-api-server-id.d.ts",
      "import": "./dist/get-schemavaults-api-server-id.js",
      "require": "./dist/get-schemavaults-api-server-id.js"
    },
    "./get-schemavaults-auth-server-uri": {
      "types": "./dist/get-schemavaults-auth-server-uri.d.ts",
      "import": "./dist/get-schemavaults-auth-server-uri.js",
      "require": "./dist/get-schemavaults-auth-server-uri.js"
    },
    "./RefreshTokenCookieNames": {
      "types": "./dist/RefreshTokenCookieNames.d.ts",
      "import": "./dist/RefreshTokenCookieNames.js",
      "require": "./dist/RefreshTokenCookieNames.js"
    },
    "./getStringByteSize": {
      "types": "./dist/getStringByteSize.d.ts",
      "import": "./dist/getStringByteSize.js",
      "require": "./dist/getStringByteSize.js"
    },
    "./redirect-to-login": {
      "types": "./dist/redirect-to-login.d.ts",
      "import": "./dist/redirect-to-login.js",
      "require": "./dist/redirect-to-login.js"
    },
    "./NextjsAppDirectoryPlugin": {
      "types": "./dist/NextjsAppDirectoryPlugin/index.d.ts",
      "import": "./dist/NextjsAppDirectoryPlugin/index.js",
      "require": "./dist/NextjsAppDirectoryPlugin/index.js"
    },
    "./NextjsAppDirectoryPlugin/*": {
      "types": "./dist/NextjsAppDirectoryPlugin/*",
      "import": "./dist/NextjsAppDirectoryPlugin/*",
      "require": "./dist/NextjsAppDirectoryPlugin/*"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  }
}
