{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "persistent": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "persistent": false
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["^build"]
    },
    "start": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": [],
      "outputs": [],
      "persistent": false
    }
  }
}
