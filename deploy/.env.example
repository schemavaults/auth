# Configuration for the single-VM auth-server deployment.
# Copy to deploy/.env (gitignored) and fill in every blank value.
#
# docker compose reads this file twice: once for ${...} interpolation inside
# docker-compose.yml (e.g. the bundled Postgres service's credentials), and
# once as the auth-server container's env_file. See auth-server/.env.example
# for full documentation of each variable, including the optional white-label
# variables not repeated here.

# Compose profiles to activate. "nginx" includes the bundled nginx
# reverse-proxy container (the default full stack). Set it empty
# (COMPOSE_PROFILES=) to run just postgres/redis/auth-server behind a
# host-level nginx instead -- see "Host-level nginx" in README.md.
COMPOSE_PROFILES=nginx

# nginx server_name for the reverse proxy (e.g. auth.example.com)
SERVER_NAME="_"

# Host address the auth-server container is published on (loopback only by
# default). Host-level nginx setups proxy to this upstream.
# AUTH_SERVER_PUBLISH_ADDRESS=127.0.0.1:3000

# The compose file also sets this on the auth-server container; defining it
# here too keeps standalone runs that load this env file (outside compose)
# on the same app environment.
SCHEMAVAULTS_APP_ENVIRONMENT="production"

# Public URL this deployment is served at (scheme + host, no trailing slash).
SCHEMAVAULTS_AUTH_SERVER_URL="https://auth.example.com"

# Must equal the auth server's own app id (SCHEMAVAULTS_AUTH_SERVER_APP_ID,
# default "schemavaults-auth").
SCHEMAVAULTS_API_SERVER_ID="schemavaults-auth"

# How the server connects to Postgres. "postgres" = direct TCP connection to
# the bundled postgres-db service (no WebSocket proxy). Switch to
# "postgres-neon-proxy" only when pointing POSTGRES_* at a Neon-compatible
# serverless endpoint instead of the bundled database.
SCHEMAVAULTS_DBH_ADAPTER="postgres"

# Postgres connection. The defaults target the bundled postgres-db service;
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DATABASE also initialize that
# service's database on first start.
POSTGRES_HOST="postgres-db"
POSTGRES_PORT=5432
POSTGRES_USER="schemavaults-auth"
POSTGRES_PASSWORD=""
POSTGRES_DATABASE="schemavaults-auth"

# Password hashing
PRIVATE_GLOBAL_PASSWORD_SALT=""
PRIVATE_PASSWORD_HASH_ROUNDS=14

# Registering with this code creates a single-use superuser invite code
PRIVATE_SUPERUSER_INVITE_CODE=""

# Multi-Factor Authentication -- generate each with: openssl rand -base64 32
PRIVATE_MFA_SECRET_KEK=""
PRIVATE_MFA_RECOVERY_PEPPER=""
